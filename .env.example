# Absolute origin of the deployed app (scheme + host, no trailing slash).
# Every link in an outgoing email is built from this. If unset, emails are
# logged and skipped — never sent with a relative/dead link.
APP_URL=

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=