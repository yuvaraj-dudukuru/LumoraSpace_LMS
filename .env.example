# ---------------------------------------------------------------------------
# LumoraSpace LMS — every environment variable the app, scripts, and
# bootstrap read. Copy to .env for local dev. See DEPLOYMENT.md for the
# production deploy order and what happens when each optional var is unset.
# ---------------------------------------------------------------------------

# --- Required -----------------------------------------------------------------

# Postgres connection string. On Neon + Vercel use the POOLED URL here (the
# app's runtime connection); run `prisma migrate deploy` and the bootstrap
# scripts from your own machine with the UNPOOLED URL instead (DEPLOYMENT.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumoraspace

# Auth.js session-signing secret. `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Absolute origin of the deployed app (scheme + host, no trailing slash), e.g.
# https://learn.example.com. Every link in an outgoing email is built from it.
# If unset, emails are logged and skipped — never sent with a dead link. Also
# the origin to allow in the R2 CORS rule.
APP_URL=http://localhost:3000

# Optional community link (Discord, Slack, a forum...). When set to an absolute
# http(s) URL, a "Community" item appears in the learner nav and opens it in
# a new tab. Unset or malformed = no nav item.
COMMUNITY_URL=

# --- Google OAuth (optional — "Continue with Google") -------------------------
# Authorized redirect URI must be ${APP_URL}/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Transactional email via Resend (optional) --------------------------------
# Unset: sends are logged and skipped; the calling action still succeeds.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Defaults to noreply@lumoraspace.dev.
EMAIL_FROM_ADDRESS=

# --- Assignment file uploads: S3-compatible object storage, e.g. Cloudflare R2
# (optional). The upload control is only rendered when ENDPOINT, ACCESS_KEY,
# SECRET_KEY and BUCKET_NAME are all set. Objects stay private; the app
# presigns PUT (upload) and GET (download) URLs. The bucket needs a CORS rule
# allowing PUT/GET from APP_URL — see DEPLOYMENT.md.
S3_ENDPOINT=
# "auto" is correct for R2 (the default when unset); an AWS region for real S3.
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# --- One-time production bootstrap only (npm run bootstrap) -------------------
# Set these in the shell for that single run — never in Vercel — and remove
# BOOTSTRAP_ADMIN_PASSWORD from your shell/env afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
