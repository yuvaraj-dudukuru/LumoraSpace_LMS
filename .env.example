# PostgreSQL connection string. Local dev default matches docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumoraspace"

# Auth.js v5 - generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""

# Google OAuth (sign_up_lumoraspace / login_lumoraspace "Continue with Google").
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@lumoraspace.dev


S3_ENDPOINT=
S3_REGION=
